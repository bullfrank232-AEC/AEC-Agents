# Copy this file to .env and fill in what you have. Everything below Section 2 is optional —
# the app runs without it, just without those Microsoft 365 features. See SETUP.md for details.

# --- 1. Database (required) ---
DATABASE_URL="file:./dev.db"

# --- 2. Auth (required) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# The URL this app is reachable at. Must match the Azure AD app's redirect URI host.
NEXTAUTH_URL="http://localhost:3000"
# Dev-only "sign in as any seeded user" picker, no password. Defaults to enabled when Azure AD
# below isn't configured. Set to "false" once Azure AD is live and this is used by your office.
ALLOW_LOCAL_LOGIN="true"

# --- 3. Azure AD / Microsoft Entra ID (sign-in + Outlook) ---
# See SETUP.md section 3a for how to get these from an App Registration.
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# --- 4. SharePoint documents (see SETUP.md section 3b) ---
SHAREPOINT_SITE_ID=""
SHAREPOINT_DRIVE_ID=""

# --- 5. Teams notifications (see SETUP.md section 3c) ---
TEAMS_WEBHOOK_URL=""
