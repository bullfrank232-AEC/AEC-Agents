# Copy this file to .env and fill in what you have. Everything below Section 2 is optional —
# the app runs without it, just without Microsoft sign-in / Teams notifications. Bid documents,
# email reminders, and calendar events need no configuration at all — see SETUP.md.

# --- 1. Database (required) ---
DATABASE_URL="file:./dev.db"

# --- 2. Auth (required) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# The URL this app is reachable at. Must match the Azure AD app's redirect URI host.
NEXTAUTH_URL="http://localhost:3000"
# Dev-only "sign in as any seeded user" picker, no password. Defaults to enabled when Azure AD
# below isn't configured. Set to "false" once Azure AD is live and this is used by your office.
ALLOW_LOCAL_LOGIN="true"

# --- 3. Azure AD / Microsoft Entra ID (optional, sign-in only) ---
# No admin approval needed — see SETUP.md section 3a. Without this, everyone just uses the
# local dev-login picker above instead of their Microsoft account.
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# --- 4. Teams notifications (optional, see SETUP.md section 3b) ---
TEAMS_WEBHOOK_URL=""
